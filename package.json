{
  "name": "traduttore",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Traduzione automatica di documenti (md, docx, txt, epub, pdf) nel browser",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:conventions": "node tool/check-docs.mjs && node tool/check-comments.mjs && node tool/check-i18n.mjs && node tool/check-test-names.mjs && node tool/check-licenses.mjs",
    "verifica": "tool/verifica.sh",
    "worker": "npx --yes wrangler@4.147.0 dev -c worker/wrangler.toml"
  },
  "dependencies": {
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.12.0",
    "franc-min": "^6.2.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  }
}
